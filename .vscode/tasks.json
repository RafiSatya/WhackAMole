{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Whack A Mole",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "main.cpp",
                "game.cpp",
                "menu.cpp",
                "-o",
                "whack_a_mole.exe",
                "-lpdcurses"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}